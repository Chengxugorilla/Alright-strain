{
  "analysis_name": "h1n1_antigenicity_novelty_next_window_backtest",
  "forecast_design": {
    "feature_window_days": 183,
    "target_window_days": 183,
    "forecast_cutoff": "T",
    "serum_panel_rule": "freeze_at_forecast_cutoff",
    "serum_date_condition": "serumDate < T",
    "serum_deduplication_key": ["seq_id_a", "serumPassCat", "serumName"],
    "query_virus_passage": "<CELL>"
  },
  "antigenicity_summary": {
    "primary_within_virus": "mean_predicted_distance_to_frozen_serum_panel",
    "sensitivity_within_virus": ["median", "p90", "min", "max"],
    "recent_window": "[T-6 months, T)",
    "annual_overall_window": "[T-12 months, T)",
    "independent_baseline_window": "[T-12 months, T-6 months)",
    "primary_within_clade": "mean_virus_composite_distance",
    "primary_comparison": "recent_clade_mean - annual_overall_mean",
    "sensitivity_comparisons": ["recent_clade_mean - previous_half_year_mean", "recent_clade_median - annual_overall_median"]
  },
  "outcomes": ["next_window_clade_share", "next_window_share_change", "next_window_top1"],
  "identity_contract": "fasta_sha256 + sequence_index + sequence_sha256",
  "note": "The panel is frozen at forecast cutoff T. The annual-overall comparator contains the recent half-year and is descriptive; the preceding half-year comparator is the independent sensitivity analysis."
}
